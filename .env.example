# Copy to .env and fill in. Nothing here needs a literal address unless you turn
# the TURN relay on: both halves are addressed by domain name.

# --- Required ---------------------------------------------------------------

# Where the browser loads the app from, and where the signaling websocket lives.
# Both need DNS records resolving to whatever fronts this host, and both are
# served over HTTPS — the camera is unavailable on a page that is not a secure
# context, so plain HTTP is not an option for the app domain.
#
# APP_DOMAIN also becomes the SFU's allowed origin: it must match what the
# address bar shows exactly, or the signaling handshake is rejected.
APP_DOMAIN=call.super-shy.ru
SFU_DOMAIN=sfu.super-shy.ru

# Single UDP port for all media. Must be reachable from the outside on this exact
# number — the SFU advertises it in its ICE candidates, so a remapped port breaks
# the connection. Forward it one-to-one if this host is behind a router.
MEDIA_UDP_PORT=7881

# --- Published HTTP ports ---------------------------------------------------
#
# What the reverse proxy forwards to. Reaching them over the LAN is fine; they do
# not need to be exposed to the internet, since the proxy is the way in.

WEB_HTTP_PORT=3300
SFU_HTTP_PORT=8080

# --- Rarely changed ---------------------------------------------------------

# The address browsers must send media to. Defaults to SFU_DOMAIN, which the SFU
# resolves at startup — set this only when the media address differs from where
# the domain points, or when DNS resolves differently inside the container than
# it does for browsers. An IP is accepted here too.
#
# Set it to a literal IP if the SFU dies at startup with
#   resolve -public-address: ... on 127.0.0.11:53: no such host
# That is Docker's resolver forwarding to a host resolver that does not know the
# name; the other way out is the `dns:` block in docker-compose.yml.
#
# Note that it is resolved once: if the address is dynamic, the container has to
# be restarted after it changes.
# PUBLIC_ADDRESS=

# Debugging only: make pion's ICE agent log what it does with every packet.
# `ice` covers connectivity checks and candidate handling, `all` adds the rest.
# PION_LOG_DEBUG=ice

# --- Optional: relay for clients that cannot reach the SFU directly ----------
#
# Leave all of these empty to run without them; a reachable SFU is enough for
# most networks. Fill them in and start coturn with:
#   docker compose --profile turn up -d
#
# TURN_DOMAIN must resolve to this host, with 3478 and the relay range reachable.

TURN_DOMAIN=turn.super-shy.ru
STUN_URL=
TURN_URL=
# Generate with: openssl rand -hex 32
TURN_SECRET=

# coturn does not resolve names — this one has to be the literal public address,
# or <public>/<private> when this host sits behind NAT.
TURN_EXTERNAL_IP=

# coturn's relay range. Also must be reachable. Widen it for more concurrent
# relayed participants; each one takes a port.
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
